{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeatherConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "refreshMinutes",
    "defaultIndex",
    "locations"
  ],
  "properties": {
    "refreshMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "defaultIndex": {
      "type": "integer",
      "minimum": 0
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "latitude",
          "longitude"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "latitude": {
            "type": "number",
            "minimum": -90.0,
            "maximum": 90.0
          },
          "longitude": {
            "type": "number",
            "minimum": -180.0,
            "maximum": 180.0
          }
        }
      }
    }
  }
}
