{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspacesConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backend",
    "count",
    "pollIntervalMs"
  ],
  "properties": {
    "backend": {
      "type": "string",
      "enum": [
        "sway",
        "niri"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "pollIntervalMs": {
      "type": "integer",
      "minimum": 100
    }
  }
}
