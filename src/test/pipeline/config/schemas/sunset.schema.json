{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SunsetConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "latitude",
    "longitude",
    "dayTemperature",
    "nightTemperature"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "latitude": {
      "type": "number",
      "minimum": -90.0,
      "maximum": 90.0
    },
    "longitude": {
      "type": "number",
      "minimum": -180.0,
      "maximum": 180.0
    },
    "dayTemperature": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 10000
    },
    "nightTemperature": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 10000
    }
  }
}
